<!-- Wspólne ustawienia kompilacji obu projektów: obsługa wartości null, automatyczne importy, ostrzeżenia jako błędy, lockfile zależności i docelowy runtime `win-x64`. -->

<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Include Windows publishing in the locked restore graph, also on Linux. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
