{
  "Detection": {
    "WindowMinutes": 5,
    "RetentionMinutes": 10,
    "StartupLookbackMinutes": 10,
    "FailureThreshold": 5,
    "DistinctAccountThreshold": 3,
    "DistinctIpThreshold": 3
  },
  "Reporting": {
    "LogName": "OSO-Warnings",
    "SourceName": "OsoLoginMonitor",
    "DataDirectory": "%ProgramData%\\OSO",
    "RetryPollSeconds": 5
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "",
    "Recipient": "",
    "PasswordFile": "%ProgramData%\\OSO\\gmail-password.bin"
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.Hosting.Lifetime": "Information" },
    "EventLog": { "LogLevel": { "Default": "Information" } }
  }
}
